V "GNAT Lib v16"
A -gnatA
A -gnatwa
A -gnat2022
A -gnata
A -gnatR2js
A -gnatws
A -gnatx
A -gnatis
A -mtune=generic
A -march=x86-64
P ZX

RN
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_PRAGMAS

U perfect_squares%b	perfect_squares.adb	68d537b3 NE OO PK

U perfect_squares%s	perfect_squares.ads	4aa1cfe6 EE NE OO PK

D perfect_squares.ads	20260918180816 4aa1cfe6 perfect_squares%s
D perfect_squares.adb	20260918180816 2274f855 perfect_squares%b
D system.ads		20260430083320 e2b7c99d system%s
G a e
G c Z s b [minimum perfect_squares 5 13 none]

